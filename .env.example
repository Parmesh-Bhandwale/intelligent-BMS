# ==========================================
# INTELLIGENT BOOK MANAGEMENT SYSTEM
# Environment Configuration Example
# ==========================================

# Copy this file to .env and fill in your values

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL connection string for async operations
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bookdb

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# Environment: development, staging, production
APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
# Secret key for JWT token signing (MUST BE CHANGED IN PRODUCTION!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# OLLAMA AI MODEL CONFIGURATION
# ==========================================
# Base URL of Ollama server
OLLAMA_BASE_URL=http://ollama:11434

# Model to use (e.g., llama3, mistral, neural-chat)
OLLAMA_MODEL=llama3

# Timeout for API calls (seconds)
OLLAMA_TIMEOUT=300.0

# Maximum concurrent requests to Ollama
OLLAMA_MAX_CONCURRENCY=2

# Text chunk size for processing long content
OLLAMA_CHUNK_SIZE=1000

# Overlap between chunks for better context
OLLAMA_CHUNK_OVERLAP=100

# ==========================================
# API CONFIGURATION
# ==========================================
# API host and port (for local development)
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==========================================
# POSTGRESQL SPECIFIC (if using Docker)
# ==========================================
POSTGRES_DB=bookdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
